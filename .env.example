# Data & Storage Paths
DATA_DIR=./data
DB_PATH=data/vmb.db
CACHE_DIR=data/cache
ORIGINALS_DIR=data/originals

# Google Photos Picker OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=data/token.json

# Downloader Settings
CACHE_MAX_DIM=1024
DOWNLOAD_CONCURRENCY=4

# AI Providers (Ollama & Aidos OpenAI-compatible)
VISION_PROVIDER=ollama
VISION_BASE_URL=http://localhost:11434/v1
VISION_API_KEY=
VISION_MODEL=qwen2.5vl

EMBED_PROVIDER=ollama
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

TEXT_PROVIDER=ollama
TEXT_BASE_URL=http://localhost:11434/v1
TEXT_API_KEY=
TEXT_MODEL=qwen2.5:14b

# Optional Aidos RFC-0103 loopback discovery file path
AIDOS_DISCOVERY_PATH=
